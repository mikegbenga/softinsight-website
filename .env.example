# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://softinsight-technologies.vercel.app

# Contact form delivery via Resend (https://resend.com) - free tier available.
# Leave RESEND_API_KEY empty and the form will honestly report that online
# delivery is not configured and point visitors to email / WhatsApp instead.
RESEND_API_KEY=
CONTACT_TO_EMAIL=mikegbenga@yahoo.com
# Must be an address on a domain verified in Resend. For first tests you can use
# onboarding@resend.dev (Resend then only delivers to your Resend account email).
CONTACT_FROM_EMAIL=SoftInsight Website <onboarding@resend.dev>
